<!-- ✅ Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

{% if app.user %}

<!-- Script dropdown + modal déconnexion -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('form').forEach(form => {
        form.setAttribute('novalidate', 'novalidate');
    });

    const userMenuBtn  = document.getElementById('userMenuBtn');
    const userDropdown = document.getElementById('userDropdown');
    const logoutBtn    = document.getElementById('logoutBtn');
    const logoutModal  = document.getElementById('logoutModal');
    const cancelLogout = document.getElementById('cancelLogout');
    const confirmLogout= document.getElementById('confirmLogout');

    if (userMenuBtn && userDropdown) {
        userMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userDropdown.classList.toggle('show');
        });

        document.addEventListener('click', (e) => {
            if (!userMenuBtn.contains(e.target) && !userDropdown.contains(e.target)) {
                userDropdown.classList.remove('show');
            }
        });
    }

    if (logoutBtn && logoutModal) {
        logoutBtn.addEventListener('click', (e) => {
            e.preventDefault();
            userDropdown.classList.remove('show');
            logoutModal.classList.add('show');
        });

        cancelLogout.addEventListener('click', () => {
            logoutModal.classList.remove('show');
        });

        logoutModal.addEventListener('click', (e) => {
            if (e.target === logoutModal) logoutModal.classList.remove('show');
        });

        confirmLogout.addEventListener('click', () => {
            window.location.href = "{{ path('app_logout') }}";
        });
    }
});
</script>

<!-- Script notifications -->
<script>
document.addEventListener('DOMContentLoaded', function () {

    const notificationBtn      = document.getElementById('notificationBtn');
    const notificationDropdown = document.getElementById('notificationDropdown');
    const notificationCount    = document.getElementById('notificationCount');

    if (!notificationBtn || !notificationDropdown || !notificationCount) return;

    function refreshCount() {
        fetch('/notifications/count-unread')
            .then(r => r.json())
            .then(data => {
                notificationCount.textContent = data.count;
                notificationCount.style.display = data.count > 0 ? 'flex' : 'none';
            });
    }

    function loadNotifications() {
        notificationDropdown.innerHTML = `
            <div class="notification-loading">
                <i class="fa-solid fa-spinner fa-spin"></i> Chargement...
            </div>`;

        fetch('/notifications/latest')
            .then(r => r.json())
            .then(data => {
                notificationDropdown.innerHTML = '';

                if (data.length === 0) {
                    notificationDropdown.innerHTML = '<div class="notification-item">Aucune notification</div>';
                    return;
                }

                data.forEach(notification => {
                    const item = document.createElement('div');
                    item.classList.add('notification-item');
                    if (!notification.isRead) item.classList.add('unread');

                    item.innerHTML = `
                        <strong>${notification.title}</strong>
                        <p>${notification.message}</p>
                    `;

                    item.addEventListener('click', function () {
                        fetch(`/notifications/${notification.id}/mark-read`, { method: 'POST' })
                            .then(() => {
                                refreshCount();
                                if (notification.actionUrl) {
                                    window.location.href = notification.actionUrl;
                                } else {
                                    loadNotifications();
                                }
                            });
                    });

                    notificationDropdown.appendChild(item);
                });
            });
    }

    refreshCount();

    notificationBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        notificationDropdown.classList.toggle('show');
        if (notificationDropdown.classList.contains('show')) loadNotifications();
    });

    document.addEventListener('click', function (e) {
        if (!notificationDropdown.contains(e.target) && !notificationBtn.contains(e.target)) {
            notificationDropdown.classList.remove('show');
        }
    });
});
</script>

<!-- Script WebSocket temps réel -->
<script>
document.addEventListener('DOMContentLoaded', function () {

    const userId = document.body.dataset.userId;
    if (!userId) return;

    let socket;

    function connectWebSocket() {
        socket = new WebSocket("ws://localhost:8081");

        socket.onopen = function () {
            console.log("✅ WS Connected");
            socket.send(JSON.stringify({ type: 'register', userId: userId }));
        };

        socket.onmessage = function (event) {
            console.log("Realtime notification:", event.data);
            fetch('/notifications/count-unread')
                .then(r => r.json())
                .then(data => {
                    const notificationCount = document.getElementById('notificationCount');
                    notificationCount.textContent = data.count;
                    notificationCount.style.display = data.count > 0 ? 'flex' : 'none';
                });
        };

        socket.onerror  = function () { socket.close(); };
        socket.onclose  = function () {
            console.log("⚠️ WS Disconnected. Reconnecting in 3s...");
            setTimeout(connectWebSocket, 3000);
        };
    }

    connectWebSocket();
});
</script>

{% endif %}{# fin app.user #}

