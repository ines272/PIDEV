</button>

<!-- Fenêtre chatbot -->
<div id="chatbot-window"
    style="position:fixed;bottom:90px;right:20px;width:370px;height:520px;
           background:white;border-radius:16px;z-index:9999;
           box-shadow:0 10px 40px rgba(0,0,0,0.2);
           display:none;flex-direction:column;overflow:hidden;">

    <!-- Header -->
    <div style="background:linear-gradient(135deg,#8B5CF6,#7C3AED);padding:16px;
                color:white;display:flex;align-items:center;gap:10px;">
        <span style="font-size:28px">🐾</span>
        <div>
            <div style="font-weight:700;font-size:16px;">Assistant SitMyPet</div>
            <div style="font-size:12px;opacity:0.8;">● En ligne</div>
        </div>
        <button id="chatbot-close"
            style="margin-left:auto;background:none;border:none;
                   color:white;font-size:20px;cursor:pointer;">✕</button>
    </div>

    <!-- Zone messages -->
    <div id="chatbot-messages"
        style="flex:1;overflow-y:auto;padding:16px;
               display:flex;flex-direction:column;gap:10px;">
        <div class="bot-bubble">
            👋 Bonjour ! Je suis l'assistant SitMyPet.<br>
            Je peux vous aider à naviguer sur notre plateforme, comprendre les rôles (propriétaire / gardien), ou trouver un gardien près de chez vous !
        </div>
    </div>

    <!-- Carte OSM (cachée par défaut) -->
    <div id="chatbot-map" style="height:180px;display:none;"></div>

    <!-- Zone saisie -->
    <div style="padding:12px;border-top:1px solid #f0f0f0;display:flex;gap:8px;">
        <input id="chatbot-input" type="text"
            placeholder="Posez votre question..."
            style="flex:1;padding:10px 14px;border:2px solid #e5e7eb;
                   border-radius:25px;outline:none;font-size:14px;">
        <button onclick="sendChatMessage()"
            style="background:#8B5CF6;color:white;border:none;border-radius:50%;
                   width:40px;height:40px;cursor:pointer;font-size:18px;">➤</button>
    </div>
</div>

<!-- Script chatbot -->
<script>
(function () {

    let map = null;

    // === Toggle ouverture/fermeture ===
    document.getElementById('chatbot-toggle').addEventListener('click', () => {
        const win = document.getElementById('chatbot-window');
        win.style.display = win.style.display === 'flex' ? 'none' : 'flex';
    });

    document.getElementById('chatbot-close').addEventListener('click', () => {
        document.getElementById('chatbot-window').style.display = 'none';
    });

    // === Envoi message ===
    document.getElementById('chatbot-input').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') sendChatMessage();
    });

    window.sendChatMessage = async function () {
        const input   = document.getElementById('chatbot-input');
        const message = input.value.trim();
        if (!message) return;

        appendChatMessage(message, 'user');
        input.value = '';

        const typingEl = appendChatMessage('...', 'bot', true);

        try {
            const res  = await fetch('/api/chatbot', {
                method : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body   : JSON.stringify({ message })
            });
            const data = await res.json();

            typingEl.remove();
            appendChatMessage(data.reply, 'bot');

            if (data.show_map) showOSMMap();

        } catch (e) {
            typingEl.remove();
            appendChatMessage("Erreur de connexion, réessayez.", 'bot');
        }
    };

    function appendChatMessage(text, sender, isTyping = false) {
        const container = document.getElementById('chatbot-messages');
        const el = document.createElement('div');
        el.className = sender === 'user'
            ? 'user-bubble'
            : ('bot-bubble' + (isTyping ? ' typing' : ''));
        el.textContent = text;
        container.appendChild(el);
        container.scrollTop = container.scrollHeight;
        return el;
    }

    function showOSMMap() {
        const mapDiv = document.getElementById('chatbot-map');
        mapDiv.style.display = 'block';

        if (map) { map.invalidateSize(); return; }

        map = L.map('chatbot-map').setView([36.8065, 10.1815], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(pos => {
                const { latitude: lat, longitude: lng } = pos.coords;
                map.setView([lat, lng], 13);
                L.marker([lat, lng])
                    .addTo(map)
                    .bindPopup('📍 Vous êtes ici')
                    .openPopup();
                loadNearbyGuardians(lat, lng);
            });
        }
    }

    async function loadNearbyGuardians(lat, lng) {
        try {
            const res     = await fetch(`/api/gardiens/nearby?lat=${lat}&lng=${lng}&radius=10`);
            const gardiens= await res.json();

            gardiens.forEach(g => {
                L.marker([g.latitude, g.longitude], {
                    icon: L.divIcon({ className: '', html: '🐕', iconSize: [30, 30] })
                }).addTo(map)
                  .bindPopup(`<b>${g.nom}</b><br>⭐ ${g.rating}<br><a href="/gardien/${g.id}">Voir profil</a>`);
            });
        } catch (e) {
            console.warn('Impossible de charger les gardiens proches.');
        }
    }

})();
</script>

